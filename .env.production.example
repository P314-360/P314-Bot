# ═══════════════════════════════════════════════════════════════════════════════
# P314 BOT - VERCEL PRODUCTION ENVIRONMENT (Pi Network Mainnet)
# ═══════════════════════════════════════════════════════════════════════════════
# This environment is used for mainnet/production deployments on Vercel.
# Set these variables in Vercel dashboard for Production deployments.

# DATABASE - MongoDB Production
MONGODB_URI=mongodb+srv://[production-user]:[production-password]@production-cluster.mongodb.net/p314_mainnet?retryWrites=true&w=majority
MONGODB_DB_NAME=p314_mainnet

# PI NETWORK - Mainnet Production
PI_APP_ID=[your-pi-mainnet-app-id]
PI_API_KEY=[your-pi-mainnet-api-key]
NEXT_PUBLIC_PI_NETWORK_URL=https://api.minepi.com
NEXT_PUBLIC_PI_NETWORK=mainnet

# SECURITY - Encryption Keys (Production)
ENCRYPTION_KEY=[generate: openssl rand -hex 32]
ENCRYPTION_IV=[generate: openssl rand -hex 16]
SESSION_SECRET=[generate: openssl rand -base64 32]

# APPLICATION - Production URLs
NEXT_PUBLIC_API_URL=https://p314-bot-1.vercel.app
NEXT_PUBLIC_ENVIRONMENT=production

# RATE LIMITING - Strict for production
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=60000

# LOGGING - Info level for production
LOG_LEVEL=info

# FEATURE FLAGS - Conservative for production
NEXT_PUBLIC_KYC_ENABLED=true
NEXT_PUBLIC_WALLET_VERIFICATION_ENABLED=true
NEXT_PUBLIC_FRAUD_REPORTING_ENABLED=true
NEXT_PUBLIC_BOUNTY_SYSTEM_ENABLED=true
