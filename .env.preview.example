# ═══════════════════════════════════════════════════════════════════════════════
# P314 BOT - VERCEL PREVIEW ENVIRONMENT (Pi Network Testnet)
# ═══════════════════════════════════════════════════════════════════════════════
# This environment is used for testnet/staging deployments on Vercel Preview.
# Set these variables in Vercel dashboard for Preview deployments.

# DATABASE - MongoDB Staging/Testnet
MONGODB_URI=mongodb+srv://[staging-user]:[staging-password]@staging-cluster.mongodb.net/p314_staging?retryWrites=true&w=majority
MONGODB_DB_NAME=p314_staging

# PI NETWORK - Testnet (Sandbox) Configuration
PI_APP_ID=[your-pi-testnet-app-id]
PI_API_KEY=[your-pi-testnet-api-key]
NEXT_PUBLIC_PI_NETWORK_URL=https://testnet-api.minepi.com
NEXT_PUBLIC_PI_NETWORK=testnet

# SECURITY - Encryption Keys (Staging)
ENCRYPTION_KEY=[generate: openssl rand -hex 32]
ENCRYPTION_IV=[generate: openssl rand -hex 16]
SESSION_SECRET=[generate: openssl rand -base64 32]

# APPLICATION - Staging URLs
NEXT_PUBLIC_API_URL=https://p314-bot-1-staging.vercel.app
NEXT_PUBLIC_ENVIRONMENT=staging

# RATE LIMITING - Generous for testing
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_WINDOW_MS=60000

# LOGGING - Debug level for staging
LOG_LEVEL=debug

# FEATURE FLAGS - Enable all for testing
NEXT_PUBLIC_KYC_ENABLED=true
NEXT_PUBLIC_WALLET_VERIFICATION_ENABLED=true
NEXT_PUBLIC_FRAUD_REPORTING_ENABLED=true
NEXT_PUBLIC_BOUNTY_SYSTEM_ENABLED=true
